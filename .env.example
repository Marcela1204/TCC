# Copie para .env e ajuste. O compose le este arquivo automaticamente.

# --- banco ---------------------------------------------------------------
# OBRIGATORIA. Fica gravada no volume do banco no primeiro `up` -- depois
# disso, mudar aqui NAO muda a senha do servidor, so a que os clientes enviam.
# Este arquivo guarda a unica copia dela e esta no .gitignore: faca backup.
SENHA_BANCO=troque-esta-senha
PORTA_BANCO=5432

# --- onde o pool de parquets e os modelos ficam no HOST ------------------
# Perder este diretorio significa perder o historico curado de treino.
POOL_HOST=./dados

# --- captura -------------------------------------------------------------
# Na maquina de IDS: a interface LIGADA AO ESPELHO do switch (SPAN) ou ao tap.
# Nao a de gerencia. Idealmente sem IP e em modo promiscuo.
CAPTURA_IFACE=eth1
NOME_SENSOR=sensor-01
DETECTOR_VISAO=flow
DETECTOR_JANELA=10
# Numa instância nova o detector espera pelo modelo promovido e reconfere
# neste intervalo (segundos). Ele não treina sozinho -- ver docker/README.md.
DETECTOR_ESPERA=15

# --- quais serviços sobem ------------------------------------------------
# Vale para TODOS os subcomandos, diferente de --profile na linha de comando.
#   sensor           captura real (network_mode: host)
#   sensor-isolado   captura com NIC dedicada (macvlan passthru)
#   replay           teste a partir de um pcap
#   painel           Grafana
COMPOSE_PROFILES=sensor,painel
UID_APP=1000
GID_APP=1000

# --- relogio do treinador ------------------------------------------------
# Dois relogios independentes:
#   TREINADOR_INTERVALO                intervalo (s) do TREINO do estagio 1
#                                      (retreino do detector). Caro, sobre
#                                      trafego acumulado -- deixe longo (24h).
#   TREINADOR_INTERVALO_CLASSIFICACAO  intervalo (s) da CLASSIFICACAO do
#                                      estagio 2 (anota os alertas pendentes
#                                      com o SVM promovido). Barato -- deixe
#                                      curto para o veredito sair quase na hora.
TREINADOR_INTERVALO=86400
TREINADOR_INTERVALO_CLASSIFICACAO=30
TREINADOR_VISOES=flow
TREINADOR_CONTAMINATION=0.01

# --- perfil replay -------------------------------------------------------
PCAP_HOST=./pcaps
PCAP=atual.pcap

# --- grafana -------------------------------------------------------------
SENHA_GRAFANA=admin
PORTA_GRAFANA=3000

TZ=America/Sao_Paulo
