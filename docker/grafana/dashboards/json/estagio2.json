    {
      "id": 6,
      "type": "table",
      "title": "Desempenho por cenario (ultimo candidato)",
      "description": "recall e precisao do SVM em particao retida, por cenario do golden set.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "netanomaly"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "netanomaly"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(scenario,scope) AS cenario, round(recall::numeric,3) AS recall, round(precisao::numeric,3) AS precisao FROM na.model_evaluations WHERE model_id=(SELECT model_id FROM na.models WHERE stage=2 ORDER BY trained_at DESC LIMIT 1) ORDER BY scope, scenario"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Fila de revisao (margem crescente)",
      "description": "Ordenada por margem: os casos mais proximos da fronteira primeiro, onde o veredito do analista mais move o hiperplano (active learning).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
