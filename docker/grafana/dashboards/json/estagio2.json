            "uid": "netanomaly"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT predicted AS predito, round(margin::numeric,3) AS margem, origem, destino, dst_port AS porta, ts FROM na.v_stage2_scatter WHERE state='pending' ORDER BY margin ASC LIMIT 50"
