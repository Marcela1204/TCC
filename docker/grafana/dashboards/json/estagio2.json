            "uid": "netanomaly"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round(EXTRACT(EPOCH FROM (now()-promoted_at))/3600) AS v FROM na.models WHERE stage=2 AND status='promoted' ORDER BY promoted_at DESC LIMIT 1",
